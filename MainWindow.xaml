<Window x:Class="Pertemuan_06_WPF_SQLServer_Integration.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Integrasi Desktop WPF &amp; SQL Server (ADO.NET) - PBKK C" 
        Height="780" Width="1160"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <!-- Modern Button Styles -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#94A3B8"/>
                    <Setter Property="Cursor" Value="No"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button">
            <Setter Property="Background" Value="#D97706"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B45309"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor" Value="No"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor" Value="No"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NeutralButton" TargetType="Button">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- KPI Cards -->
            <RowDefinition Height="*"/>    <!-- Main Content -->
        </Grid.RowDefinitions>

        <!-- 1. Header Banner -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="18,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Sistem Manajemen Mahasiswa Terintegrasi Database (SQL Server)" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Praktikum Koneksi Database Relasional &amp; ADO.NET CRUD — PBKK C" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#0F172A" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="SQL Server LocalDB Online" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. KPI Cards Row -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Mahasiswa di DB -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TOTAL RECORD DI DATABASE" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="lblTotalMahasiswa" Text="0" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="20" Width="36" Height="36" VerticalAlignment="Center">
                        <TextBlock Text="🗄️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Rata-rata IPK -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="RATA-RATA IPK KELAS" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="lblRataIpk" Text="0.00" FontSize="20" FontWeight="Bold" Foreground="#059669" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#ECFDF5" CornerRadius="20" Width="36" Height="36" VerticalAlignment="Center">
                        <TextBlock Text="📈" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Status Koneksi Engine -->
            <Border Grid.Column="4" Background="White" CornerRadius="8" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="DATABASE &amp; TABEL" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="lblDatabaseName" Text="DbMahasiswaPBKK.dbo.Mahasiswa" FontSize="13" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EEF2FF" CornerRadius="20" Width="36" Height="36" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Main Content: 2 Columns (Form Input & DataGrid DB) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Form Input / Edit Data ke Database -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Formulir Operasi Database" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

                        <!-- Mode Indicator -->
                        <Border x:Name="badgeFormMode" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,10">
                            <TextBlock x:Name="txtFormMode" Text="Mode: Tambah Record Baru (INSERT)" FontSize="11" FontWeight="SemiBold" Foreground="#1E40AF"/>
                        </Border>

                        <!-- NRP -->
                        <TextBlock Text="NRP (Unique Key) *" FontWeight="Medium" Foreground="#475569" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtNrp" Margin="0,0,0,8"/>

                        <!-- Nama Lengkap -->
                        <TextBlock Text="Nama Lengkap *" FontWeight="Medium" Foreground="#475569" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtNama" Margin="0,0,0,8"/>

                        <!-- Program Studi -->
                        <TextBlock Text="Program Studi *" FontWeight="Medium" Foreground="#475569" Margin="0,0,0,3"/>
                        <ComboBox x:Name="cmbProdi" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,8">
                            <ComboBoxItem Content="Teknik Informatika" IsSelected="True"/>
                            <ComboBoxItem Content="Sistem Informasi"/>
                            <ComboBoxItem Content="Teknologi Informasi"/>
                            <ComboBoxItem Content="Sains Data"/>
                            <ComboBoxItem Content="Rekayasa Perangkat Lunak"/>
                            <ComboBoxItem Content="Teknik Komputer"/>
                        </ComboBox>

                        <!-- Angkatan & IPK (2 Columns) -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Angkatan *" FontWeight="Medium" Foreground="#475569" Margin="0,0,0,3"/>
                                <ComboBox x:Name="cmbAngkatan" Height="32" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="2021"/>
                                    <ComboBoxItem Content="2022"/>
                                    <ComboBoxItem Content="2023"/>
                                    <ComboBoxItem Content="2024" IsSelected="True"/>
                                    <ComboBoxItem Content="2025"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="IPK (0 - 4.00) *" FontWeight="Medium" Foreground="#475569" Margin="0,0,0,3"/>
                                <TextBox x:Name="txtIpk" Margin="0,0,0,0" Text="3.80"/>
                            </StackPanel>
                        </Grid>

                        <!-- Status Mahasiswa -->
                        <TextBlock Text="Status Mahasiswa *" FontWeight="Medium" Foreground="#475569" Margin="0,0,0,3"/>
                        <ComboBox x:Name="cmbStatus" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,14">
                            <ComboBoxItem Content="Aktif" IsSelected="True"/>
                            <ComboBoxItem Content="Cuti"/>
                        </ComboBox>

                        <!-- Action Buttons -->
                        <StackPanel>
                            <Button x:Name="btnTambah" Content="+ Simpan ke Database (INSERT)" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6" Click="btnTambah_Click"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnUpdate" Grid.Column="0" Content="Ubah (UPDATE)" Style="{StaticResource WarningButton}" IsEnabled="False" Click="btnUpdate_Click"/>
                                <Button x:Name="btnHapus" Grid.Column="2" Content="Hapus (DELETE)" Style="{StaticResource DangerButton}" IsEnabled="False" Click="btnHapus_Click"/>
                            </Grid>
                            <Button x:Name="btnBatal" Content="Reset Formulir / Batal" Style="{StaticResource NeutralButton}" Click="btnBatal_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Column: DataGrid & Live SQL Search -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search & Filter -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                        <RowDefinition Height="Auto"/> <!-- Footer Info -->
                    </Grid.RowDefinitions>

                    <!-- Top Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tabel Mahasiswa (Database SQL Server)" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Kueri data langsung via ADO.NET SqlConnection &amp; SqlDataReader" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔍 Filter SQL:" VerticalAlignment="Center" FontWeight="Medium" Foreground="#64748B" Margin="0,0,6,0"/>
                            <TextBox x:Name="txtCari" Width="180" Height="30" TextChanged="txtCari_TextChanged" Tag="Ketik NRP / Nama..."/>
                            <Button x:Name="btnRefresh" Content="🔄 Refresh" Style="{StaticResource NeutralButton}" Margin="8,0,0,0" Padding="8,5" Click="btnRefresh_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid x:Name="dgMahasiswa" Grid.Row="1"
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              RowBackground="White"
                              AlternatingRowBackground="#F8FAFC"
                              BorderThickness="1"
                              BorderBrush="#E2E8F0"
                              RowHeight="32"
                              FontSize="12"
                              SelectionChanged="dgMahasiswa_SelectionChanged">
                        
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#334155"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NRP" Binding="{Binding Nrp}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#1E293B"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Nama Lengkap" Binding="{Binding Nama}" Width="1.3*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Program Studi" Binding="{Binding Prodi}" Width="1.1*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#334155"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Angkatan" Binding="{Binding Angkatan}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#475569"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="IPK" Binding="{Binding Ipk, StringFormat={}{0:F2}}" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#059669"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Status" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                    <Setter Property="BorderBrush" Value="#86EFAC"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Cuti">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                            <Setter Property="BorderBrush" Value="#FCD34D"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#15803D"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Cuti">
                                                                <Setter Property="Foreground" Value="#B45309"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Tanggal Dibuat" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="125">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#64748B"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer Note -->
                    <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="4" Padding="8" Margin="0,10,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                        <TextBlock Text="🔒 Keamanan Terjamin: Seluruh eksekusi query (SELECT, INSERT, UPDATE, DELETE) menggunakan Parameterized SqlCommand untuk mencegah SQL Injection." FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
